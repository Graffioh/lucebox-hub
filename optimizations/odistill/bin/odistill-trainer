#!/bin/sh
# Executable the engine execv()s for --odistill-trainer-bin. Resolves this
# package's environment regardless of the server's cwd, then hands all
# arguments (including the inherited --stream-fd) to the trainer module.
#
# Use the explicitly provisioned environment first. On ROCm hosts this must
# contain AMD's torch wheel; automatically resolving generic PyPI torch can
# silently install an unusable CUDA/CPU build. Set ODISTILL_ALLOW_UV=1 only for
# an intentional CPU/dev environment.
here="$(cd "$(dirname "$0")/.." && pwd)"
if [ -x "$here/.venv/bin/python" ]; then
    PYTHONPATH="$here/src${PYTHONPATH:+:$PYTHONPATH}" \
        exec "$here/.venv/bin/python" -m odistill "$@"
fi
if [ "${ODISTILL_ALLOW_UV:-0}" = "1" ] && command -v uv >/dev/null 2>&1; then
    exec uv run --project "$here" --extra train python -m odistill "$@"
fi
echo "[odistill-trainer] no provisioned $here/.venv; see $here/README.md" >&2
exit 1
